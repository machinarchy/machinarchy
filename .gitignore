# ==============================================================================
# Machinarchy Production .gitignore (Blacklist Strategy)
# ==============================================================================

# 1. Binaries, Build Outputs & Test Artifacts
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.test
*.prof
*.s
*.zip
*.patch

# 2. Databases & Local Runtime Data
/data/
*.db
*.db-shm
*.db-wal

# 3. Secrets & Environment Files
.env
*.pem
*.key
*.cert
secrets/

# 4. Logs & Metrics dumps
*.log
*.jsonl
metrics/

# 5. IDEs, Editors & Operating System Junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.history/

# 6. Go Workspace and Vendor (if using local vendor caching)
# vendor/
go.work
go.work.sum