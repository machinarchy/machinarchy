#!/usr/bin/env bash
# Enforce Conventional Commit subjects used by Release Please.
set -Eeuo pipefail

if [[ $# -ne 1 || ! -f "$1" ]]; then
  echo "Usage: $0 <commit-message-file>" >&2
  exit 2
fi

commit_message_file="$1"
first_line="$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$commit_message_file" | head -n 1 || true)"
[[ -z "$first_line" ]] && exit 0

core_pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?(!)?: .+'
rebase_pattern='^(fixup|squash|amend)! .+'

if [[ "$first_line" =~ $core_pattern || "$first_line" =~ $rebase_pattern ]]; then
  echo "Conventional Commit subject accepted."
  exit 0
fi

cat >&2 <<EOF_ERROR
Error: commit subject does not follow Conventional Commits.

Examples:
  feat: add host enrollment endpoint
  fix(ssh): handle connection timeout
  docs: update installation guide
  refactor(api)!: remove deprecated REST endpoint

Received:
  $first_line
EOF_ERROR
exit 1
