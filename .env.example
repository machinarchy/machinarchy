# ==============================================================================
# Machinarchy Control-Plane Configuration (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server binding address (host:port)
MACHINARCHY_LISTEN_ADDR=:8080
# Serve /metrics on its own port instead of the API port (recommended in production).
# MACHINARCHY_METRICS_LISTEN_ADDR=:9090
# /openapi.json and /scalar: on in development, off in production unless set.
# MACHINARCHY_API_DOCS_ENABLED=true

# Runtime environment: development, test, or production
MACHINARCHY_ENVIRONMENT=development

# Self-registration is disabled by default in every environment. Each new
# account joins the shared workspace as a reader and can read the inventory.
# Set true only when account registration is intentionally available.
# MACHINARCHY_SIGNUP_ENABLED=true

# Login-session signing secret. Set to at least 32 random characters.
MACHINARCHY_OPERATOR_TOKEN=
# During a rotation: earlier MACHINARCHY_OPERATOR_TOKEN values (comma-separated),
# accepted only to verify sessions issued before it. Remove after the session TTL.
# MACHINARCHY_SESSION_PREVIOUS_KEYS=
# Login session lifetime (5m-168h).
# MACHINARCHY_SESSION_TTL=24h
# Failed-login throttling: free failures per account, longest backoff,
# failures per client network, and the window they are counted in.
# MACHINARCHY_LOGIN_FREE_FAILURES=5
# MACHINARCHY_LOGIN_MAX_BACKOFF=15m
# MACHINARCHY_LOGIN_IP_MAX_FAILURES=20
# MACHINARCHY_LOGIN_FAILURE_WINDOW=15m

# Credential encryption secret. Keep stable across deployments and back it up
# separately from the JWT signing secret; changing it makes stored credentials unreadable.
MACHINARCHY_ENCRYPTION_SECRET=
# Optional key identifier and previous-key file for controlled KEK rotation.
# Key files must be regular files with permissions 0600 or stricter. The JSON
# keyring maps old key IDs to old key values; keep it outside the database.
# MACHINARCHY_ENCRYPTION_SECRET_FILE=/run/secrets/machinarchy-kek
# MACHINARCHY_ENCRYPTION_KEY_ID=bootstrap-v1
# MACHINARCHY_ENCRYPTION_KEYRING_FILE=/run/secrets/machinarchy-keyring.json

# Bootstrap configuration can also be loaded from a JSON object of string
# settings with --config FILE. Non-secret flags override environment, which
# overrides the file; secret values must come from environment or protected
# files and are never accepted in flags or the bootstrap JSON.
# Supported examples: --listen-addr, --database-engine, --database-path,
# --database-url, --log-level, --signup-enabled.

# Optional first owner account. Created only while the default workspace has no
# owner; self-registered accounts are always read-only members. Use a unique
# password of 12-72 bytes and remove it from the environment after first start.
# MACHINARCHY_BOOTSTRAP_ADMIN_USERNAME=admin
# MACHINARCHY_BOOTSTRAP_ADMIN_EMAIL=
# MACHINARCHY_BOOTSTRAP_ADMIN_PASSWORD=

# NATS is not used by the controller today; internal events go through the
# database outbox. The agent gateway will reintroduce a NATS setting.

# Command execution (POST /api/v1/runs). Off by default. When enabled you must
# list the programs that may run (exact names or paths, comma-separated); "*"
# allows any program and must be chosen deliberately. Starting runs also needs
# the runs:execute permission (owners and operators).
# MACHINARCHY_EXECUTION_ENABLED=false
# MACHINARCHY_EXECUTION_ALLOWED_PROGRAMS=uptime,/usr/bin/df

# Logging level: debug, info, warn, or error
MACHINARCHY_LOG_LEVEL=info

# Total time to stop all components after SIGTERM. Keep it below the
# orchestrator grace period (compose stop_grace_period, Kubernetes
# terminationGracePeriodSeconds).
# MACHINARCHY_SHUTDOWN_TIMEOUT=25s

# Required in production; comma-separated exact browser origins.
# CORS_ALLOWED_ORIGINS=https://console.example.com

# Optional OpenTelemetry OTLP/HTTP export. When unset, local OTLP export is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Database Configuration (sqlite or postgres)
MACHINARCHY_DATABASE_ENGINE=sqlite
MACHINARCHY_DATABASE_PATH=./data/machinarchy.db
# Uncomment below if using PostgreSQL:
# MACHINARCHY_DATABASE_URL=postgres://machinarchy:password@localhost:5432/machinarchy?sslmode=disable

# Advanced Database Tuning (Optional overrides)
# MACHINARCHY_DATABASE_MAX_OPEN_CONNS=1
# MACHINARCHY_DATABASE_MAX_IDLE_CONNS=1
# MACHINARCHY_DATABASE_CONN_MAX_LIFETIME=0s
# MACHINARCHY_DATABASE_CONNECT_TIMEOUT=5s
# Schema migrations at startup; a migration that rewrites a large table needs time.
# MACHINARCHY_DATABASE_MIGRATION_TIMEOUT=10m

# SSH target network policy. Hostnames are resolved once and the validated
# address is the one dialed; every resolved address must be permitted.
# Always denied: unspecified, multicast, broadcast, zoned, and cloud-metadata
# addresses. Denied by default: loopback, link-local, and private ranges
# (RFC 1918, CGNAT, fc00::/7). Enable private ranges only for trusted inventory.
# MACHINARCHY_SSH_ALLOW_PRIVATE=false
# MACHINARCHY_SSH_ALLOW_LOOPBACK=false
# Comma-separated CIDRs or IPs. Explicit allowed ranges override loopback,
# link-local, and private defaults (never the always-denied set); denied ranges override allowed.
# MACHINARCHY_SSH_ALLOWED_CIDRS=
# MACHINARCHY_SSH_DENIED_CIDRS=
# SSH TCP ports are denied unless listed here; runtime SSH configuration can hot-reload this allowlist.
# MACHINARCHY_SSH_ALLOWED_PORTS=22
# How SSH host keys become trusted when an Access Profile does not choose:
# tofu (development default), approve (production default) or pinned.
# MACHINARCHY_SSH_HOST_KEY_POLICY=approve

# SSH targets must be registered with a pinned SHA-256 host-key fingerprint.

# Agent gateway (controller side of machinarchy-agent). Off unless the NATS URL
# is set. Key material only from 0600 files:
#   openssl rand -base64 32 > secrets/agent-signing.key   # Ed25519 seed
#   openssl rand -hex 32    > secrets/agent-enroll.token
# The controller public key agents must pin is logged at startup and served at
# GET /api/v1/agents/controller-key. Production requires tls:// or a CA file.
# MACHINARCHY_AGENT_GATEWAY_NATS_URL=nats://127.0.0.1:4222
# MACHINARCHY_AGENT_GATEWAY_SIGNING_KEY_FILE=./secrets/agent-signing.key
# MACHINARCHY_AGENT_GATEWAY_ENROLLMENT_TOKEN_FILE=./secrets/agent-enroll.token
# MACHINARCHY_AGENT_GATEWAY_NATS_CREDENTIALS_FILE=
# MACHINARCHY_AGENT_GATEWAY_NATS_CA_FILE=
# MACHINARCHY_AGENT_GATEWAY_NATS_CERT_FILE=
# MACHINARCHY_AGENT_GATEWAY_NATS_KEY_FILE=
# MACHINARCHY_AGENT_GATEWAY_LEASE_TTL=60s
# MACHINARCHY_AGENT_GATEWAY_HEARTBEAT=15s
# Per-agent NATS credentials (NATS operator mode; required in production):
# MACHINARCHY_AGENT_GATEWAY_NATS_ACCOUNT=A...
# MACHINARCHY_AGENT_GATEWAY_NATS_ACCOUNT_SIGNING_KEY_FILE=./secrets/nats-account-signing.nk
# MACHINARCHY_AGENT_GATEWAY_AGENT_JWT_TTL=1h
