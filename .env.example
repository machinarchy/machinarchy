# ==============================================================================
# Machinarchy Control-Plane Configuration (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server binding address (host:port)
MACHINARCHY_LISTEN_ADDR=:8080

# Runtime environment: development, test, or production
MACHINARCHY_ENVIRONMENT=development

# Self-registration defaults to enabled in development and disabled in production.
# Set true temporarily or intentionally when account registration is required.
# MACHINARCHY_SIGNUP_ENABLED=true

# JWT signing secret. Set to at least 32 random characters.
MACHINARCHY_OPERATOR_TOKEN=

# Credential encryption secret. Keep stable across deployments and back it up
# separately from the JWT signing secret; changing it makes stored credentials unreadable.
MACHINARCHY_ENCRYPTION_SECRET=
# Optional key identifier and previous-key file for controlled KEK rotation.
# Key files must be regular files with permissions 0600 or stricter. The JSON
# keyring maps old key IDs to old key values; keep it outside the database.
# MACHINARCHY_ENCRYPTION_SECRET_FILE=/run/secrets/machinarchy-kek
# MACHINARCHY_ENCRYPTION_KEY_ID=bootstrap-v1
# MACHINARCHY_ENCRYPTION_KEYRING_FILE=/run/secrets/machinarchy-keyring.json

# Bootstrap configuration can also be loaded from a JSON object of string
# settings with --config FILE. Non-secret flags override environment, which
# overrides the file; secret values must come from environment or protected
# files and are never accepted in flags or the bootstrap JSON.
# Supported examples: --listen-addr, --database-engine, --database-path,
# --database-url, --log-level, --signup-enabled.

# Optional first owner account. Created only while the default workspace has no
# owner; self-registered accounts are always read-only members. Use a unique
# password of 12-72 bytes and remove it from the environment after first start.
# MACHINARCHY_BOOTSTRAP_ADMIN_USERNAME=admin
# MACHINARCHY_BOOTSTRAP_ADMIN_EMAIL=
# MACHINARCHY_BOOTSTRAP_ADMIN_PASSWORD=

# NATS JetStream URL (required by the API and control manager at startup).
# MACHINARCHY_BROKER_URL=nats://localhost:4222

# Command execution (POST /api/v1/runs). Off by default. When enabled you must
# list the programs that may run (exact names or paths, comma-separated); "*"
# allows any program and must be chosen deliberately. Starting runs also needs
# the runs:execute permission (owners and operators).
# MACHINARCHY_EXECUTION_ENABLED=false
# MACHINARCHY_EXECUTION_ALLOWED_PROGRAMS=uptime,/usr/bin/df

# Logging level: debug, info, warn, or error
MACHINARCHY_LOG_LEVEL=info

# Required in production; comma-separated exact browser origins.
# CORS_ALLOWED_ORIGINS=https://console.example.com

# Optional OpenTelemetry OTLP/HTTP export. When unset, local OTLP export is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Database Configuration (sqlite or postgres)
MACHINARCHY_DATABASE_ENGINE=sqlite
MACHINARCHY_DATABASE_PATH=./data/machinarchy.db
# Uncomment below if using PostgreSQL:
# MACHINARCHY_DATABASE_URL=postgres://machinarchy:password@localhost:5432/machinarchy?sslmode=disable

# Advanced Database Tuning (Optional overrides)
# MACHINARCHY_DATABASE_MAX_OPEN_CONNS=1
# MACHINARCHY_DATABASE_MAX_IDLE_CONNS=1
# MACHINARCHY_DATABASE_CONN_MAX_LIFETIME=0s
# MACHINARCHY_DATABASE_CONNECT_TIMEOUT=5s

# SSH target network policy. Hostnames are resolved once and the validated
# address is the one dialed; every resolved address must be permitted.
# Always denied: unspecified, multicast, broadcast, zoned, and cloud-metadata
# addresses. Denied by default: loopback and link-local. Private ranges
# (RFC 1918, CGNAT, fc00::/7) are allowed unless disabled here.
# MACHINARCHY_SSH_ALLOW_PRIVATE=true
# MACHINARCHY_SSH_ALLOW_LOOPBACK=false
# Comma-separated CIDRs or IPs. Allowed ranges override the loopback/link-local/
# private defaults (never the always-denied set); denied ranges override allowed.
# MACHINARCHY_SSH_ALLOWED_CIDRS=
# MACHINARCHY_SSH_DENIED_CIDRS=

# SSH targets must be registered with a pinned SHA-256 host-key fingerprint.
